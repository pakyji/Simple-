module.exports = {
    name: "runtime",
    description: "Check how long the bot has been running",
    async execute(sock, msg, sender, args) {
        try {
            const uptimeSeconds = process.uptime();
            
            // Calculate days, hours, minutes, and seconds
            const days = Math.floor(uptimeSeconds / (3600 * 24));
            const hours = Math.floor((uptimeSeconds % (3600 * 24)) / 3600);
            const minutes = Math.floor((uptimeSeconds % 3600) / 60);
            const seconds = Math.floor(uptimeSeconds % 60);

            let runtimeString = "";
            if (days > 0) runtimeString += `${days}d `;
            if (hours > 0 || days > 0) runtimeString += `${hours}h `;
            if (minutes > 0 || hours > 0 || days > 0) runtimeString += `${minutes}m `;
            runtimeString += `${seconds}s`;

            const responseText = `╭━━━〔 ⚡ *BOT RUNTIME* ⚡ 〕━━━⣣\n` +
                                 `┃\n` +
                                 `┃  ⏱️ *Active Since:* ${runtimeString}\n` +
                                 `┃  🚀 *Status:* Stable & Online\n` +
                                 `┃\n` +
                                 `╰━━━━━━━━━━━━━━━━━━━━━━━━━━⣭`;

            await sock.sendMessage(sender, { text: responseText }, { quoted: msg });

        } catch (error) {
            console.error("Runtime error:", error);
            await sock.sendMessage(sender, { text: "❌ Failed to fetch bot runtime." }, { quoted: msg });
        }
    }
};
