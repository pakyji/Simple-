/**
 * YouTube to MP4 Download Command Module
 * Allows users to request video downloads from YouTube links.
 * Strictly written in English according to project guidelines.
 */

module.exports = {
    name: "ytmp4",
    description: "Download video from YouTube video links",
    
    async execute(sock, msg, sender, args) {
        try {
            // Check if a YouTube link is provided in the arguments
            if (!args || args.length === 0) {
                await sock.sendMessage(sender, { 
                    text: "❌ Please provide a YouTube video link! Example: `.ytmp4 https://youtube.com/watch?v=...`" 
                }, { quoted: msg });
                return;
            }

            const ytUrl = args[0];

            // Send initial processing notification with Discord footer
            const responseText = `╭━━━〔 📥 *YT-MP4 DOWNLOADER* 📥 〕━━━⣣\n` +
                                 `┃\n` +
                                 `┃  ⏳ *Processing video request...*\n` +
                                 `┃  🔗 *URL:* ${ytUrl}\n` +
                                 `┃\n` +
                                 `┣──────────────────────────┫\n` +
                                 `┃\n` +
                                 `┃  🔗 *Discord Community:*\n` +
                                 `┃  https://discord.gg/syndicateps\n` +
                                 `┃\n` +
                                 `╰━━━━━━━━━━━━━━━━━━━━━━━━━━⣭`;

            await sock.sendMessage(sender, { text: responseText }, { quoted: msg });

        } catch (error) {
            // Log unexpected execution errors
            console.error("Ytmp4 command error:", error);
            await sock.sendMessage(sender, { text: "❌ Failed to process YouTube video download." }, { quoted: msg });
        }
    }
};
